
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String a = sc.next();
        String b = sc.next();

        int n = a.length();
        int m = b.length();
        long answer = 0;

        for (int i = 0; i <= m - n; i++) {
            for (int j = 0; j < n; j++) {
                if (a.charAt(j) != b.charAt(i + j)) {
                    answer++;
                }
            }
        }

        System.out.println(answer);

        sc.close();
    }
}
