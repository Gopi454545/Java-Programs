
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int T = sc.nextInt();

        while (T-- > 0) {
            int n = sc.nextInt();
            String s = sc.next();

            boolean possible = true;
            int b = 0;
            int r = 0;
            int length = 0;

            for (int i = 0; i < n; i++) {
                char c = s.charAt(i);

                if (c == 'W') {
                    // Check the colored segment before W
                    if (length > 0) {
                        if (length < 2 || b == 0 || r == 0) {
                            possible = false;
                        }
                    }

                    b = 0;
                    r = 0;
                    length = 0;
                } else {
                    length++;

                    if (c == 'B') {
                        b++;
                    } else if (c == 'R') {
                        r++;
                    }
                }
            }

            // Check the final colored segment
            if (length > 0) {
                if (length < 2 || b == 0 || r == 0) {
                    possible = false;
                }
            }

            System.out.println(possible ? "YES" : "NO");
        }

        sc.close();
    }
}
