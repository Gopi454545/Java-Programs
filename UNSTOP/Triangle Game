
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        long value = 1;

        for (int i = 0; i <= n; i++) {
            System.out.print(value + " ");
            value = value * (n - i) / (i + 1);
        }

        sc.close();
    }
}
