
import java.util.*;

public class Main {
    static class Node {
        int data;
        Node left, right;

        Node(int data) {
            this.data = data;
        }
    }

    static Node insert(Node root, int value) {
        if (root == null) {
            return new Node(value);
        }

        if (value < root.data) {
            root.left = insert(root.left, value);
        } else {
            root.right = insert(root.right, value);
        }

        return root;
    }

    static int rangeSum(Node root, int start, int end) {
        if (root == null) {
            return 0;
        }

        if (root.data < start) {
            return rangeSum(root.right, start, end);
        }

        if (root.data > end) {
            return rangeSum(root.left, start, end);
        }

        return root.data
                + rangeSum(root.left, start, end)
                + rangeSum(root.right, start, end);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        Node root = null;

        for (int i = 0; i < n; i++) {
            root = insert(root, sc.nextInt());
        }

        int start = sc.nextInt();
        int end = sc.nextInt();

        System.out.println(rangeSum(root, start, end));

        sc.close();
    }
}
