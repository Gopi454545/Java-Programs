
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        Deque<Long> stack = new ArrayDeque<>();
        long total = 0;

        for (int i = 0; i < n; i++) {
            long x = sc.nextLong();

            if (x >= 0) {
                stack.addLast(x);
                total += x;
            } else {
                long need = -x;
                long sum = 0;

                while (!stack.isEmpty() && sum < need) {
                    long value = stack.removeLast();
                    sum += value;
                    total -= value;
                }

                long positive = need;
                stack.addLast(positive);
                total += positive;
            }
        }

        System.out.println(total);

        sc.close();
    }
}
